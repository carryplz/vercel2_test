# 카카오 개발자센터 > 내 애플리케이션 > 앱 키 > JavaScript 키
KAKAO_JS_KEY=

# Supabase > Connect > Connection String > Transaction pooler(6543, 권장) 또는 Session pooler(5432)
# [YOUR-PASSWORD] 부분을 DB 비밀번호로 바꿔서 넣는다
DATABASE_URL=

# Google AI Studio에서 발급 (문장형 검색 해석용)
GEMINI_API_KEY=
# 선택: 사용할 Gemini 모델 (기본 gemini-3.5-flash-lite)
GEMINI_MODEL=
